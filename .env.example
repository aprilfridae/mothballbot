# ── Required ────────────────────────────────────────────────
# Postgres (docker compose builds DATABASE_URL for the app from this; letters and numbers only)
POSTGRES_PASSWORD=
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
TELEGRAM_TOKEN=
# Random secret for Mom's Telegram start link (e.g. openssl rand -hex 8)
MOM_LINK_CODE=

# ── Optional: Discord IDs ───────────────────────────────────
# Leave empty and the bot uses its server's owner and finds/creates #new-listing, #buyers (forum),
# #sales, #to-ship and #bot-status by itself.
OWNER_DISCORD_ID=
CHANNEL_NEW_LISTING=
CHANNEL_BUYERS=
CHANNEL_SALES=
CHANNEL_TO_SHIP=
CHANNEL_BOT_STATUS=

# ── eBay (fill all of these, or none while approval is pending) ──
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
# Your eBay seller username, so your own messages aren't mirrored as buyer messages
EBAY_USERNAME=
